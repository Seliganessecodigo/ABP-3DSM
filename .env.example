# Local development defaults only. Replace values only with local credentials.
NODE_ENV=development

# Web application and API
FRONTEND_PORT=5173
API_PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL container (local-only credentials; never use these in shared environments)
POSTGRES_DB=greener
POSTGRES_USER=greener
POSTGRES_PASSWORD=greener_dev_only
POSTGRES_PORT=5432

# Used by Prisma and the backend when running on the host.
DATABASE_URL=postgresql://greener:greener_dev_only@localhost:5432/greener?schema=public

# Official auxiliary APIs; backend only.
METRICS_AGGREGATOR_URL=https://metrics.unilaunch.org
CARBON_INTENSITY_URL=https://carbon.unilaunch.org

# Authentication: generate independent random secrets of at least 32 bytes for shared environments.
AUTH_JWT_SECRET=local_only_replace_before_deploy_01_234567890123456789
AUTH_PASSWORD_PEPPER=local_only_replace_before_deploy_02_234567890123456789
AUTH_PASSWORD_PEPPER_VERSION=legacy
# For pepper rotation, set AUTH_PASSWORD_PEPPER_KEYS to a JSON map that retains
# every pepper version still in use, and set AUTH_PASSWORD_PEPPER_VERSION to its active key.
AUTH_PASSWORD_PEPPER_KEYS=
AUTH_TOTP_ENCRYPTION_KEY_VERSION=local-v1
# Local-only 32-byte key. Replace with externally managed keys outside development.
AUTH_TOTP_ENCRYPTION_KEYS={"local-v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
APP_BASE_URL=http://localhost:5173

# Google OIDC for backend SSO. Register the callback URI in Google Cloud Console.
# Keep the real client secret in your local .env or deployment secret store.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/sso/google/callback
SSO_RETURN_URL=http://localhost:5173/sso/callback

# SMTP delivery for organization invitations and email confirmation.
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=
# Optional for an SMTP relay that requires authentication.
# SMTP_USER=
# SMTP_PASSWORD=
