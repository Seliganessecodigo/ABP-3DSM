{
  "name": "green-er",
  "version": "0.1.0",
  "private": true,
  "description": "GreenER local development orchestration",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:detached": "docker compose up --build --detach",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs --follow",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:preview": "npm --prefix docs run preview"
  },
  "engines": {
    "node": ">=24"
  }
}
